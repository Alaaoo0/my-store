generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Int
  weight      Int
  imageUrl    String?
  stock       Int         @default(10)
  category    String      @default("أجهزة الكترونية")
  variants    String?
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
  reviews     Review[]
}

model Order {
  id                String      @id @default(cuid())
  customerName      String
  phone             String
  address           String
  total             Int
  status            String      @default("pending")
  customerConfirmed Boolean     @default(false)
  couponId          String?
  coupon            Coupon?     @relation(fields: [couponId], references: [id])
  discountAmount    Int         @default(0)
  createdAt         DateTime    @default(now())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  variant   String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String      @id @default(cuid())
  code          String      @unique
  type          CouponType
  value         Float
  minOrderValue Float       @default(0)
  maxUses       Int?
  usedCount     Int         @default(0)
  isActive      Boolean     @default(true)
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]
}

model Settings {
  id            String @id @default("global")
  siteName      String @default("Ali-Boss")
  heroTitle     String @default("تخفيضات الميجا سيل!")
  heroSubtitle  String @default("خصومات تصل لـ 70% | توصيل سريع لكل لبنان")
  heroBtnText   String @default("تسوق الآن")
  discountBadge String @default("خصم 15%")
  whatsapp      String @default("96170000000")
  whishNumber   String @default("0000000")
  email         String @default("info@aliboss.com")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?
  imageUrl  String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  password           String
  phone              String?
  walletBalance      Float               @default(0)
  createdAt          DateTime            @default(now())
  orders             Order[]
  reviews            Review[]
  walletTransactions WalletTransaction[]
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// 👇 الجدول الجديد لحماية الأدمن
model LoginAttempt {
  id          String   @id @default(cuid())
  ip          String   @unique
  attempts    Int      @default(0)
  lastAttempt DateTime @default(now())
}
